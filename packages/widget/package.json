{
  "name": "@zenith/widget",
  "version": "0.1.6",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "react-dom": "^19.3.0",
    "tsup": "^9.0.0",
    "react": "^19.3.0"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "development": "./src/react/index.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "development": "./src/version.ts",
      "import": "./dist/version.js",
      "require": "./dist/version.cjs"
    },
    "./browser.js": "./dist/browser.js"
  },
  "description": "Official SDK for the Zenith feedback widget. Embed Zenith in your app.",
  "files": [
    "dist",
    "src",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "homepage": "/source.html",
  "keywords": [
    "zenith",
    "feedback",
    "widget",
    "customer-feedback",
    "feature-requests"
  ],
  "license": "AGPL-3.0",
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "private": true,
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "html2canvas-pro": "2.5.2"
  }
}
